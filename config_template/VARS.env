# ====== config/VARS.env (universal, target-agnostic secrets) ======
# Copy this file to config/VARS.env (gitignored) and fill in real values:
#   cp config_template/VARS.env config/VARS.env
# Plain dotenv: KEY="value" per line; quote values containing $.
# Loaded on demand by the commands that need it — scripts/renovate.sh and the
# in-cluster renovate CronJob (srv0) do `set -a; . config/VARS.env`.

# GitHub token Renovate uses to open update PRs on ImranR98/Infra.
# Fine-grained PAT: Contents -> Read and write, Pull requests -> Read and write
# (classic alternative: a token with the `repo` scope).
RENOVATE_GITHUB_TOKEN="change_me"
