# ====== config/VARS.env (universal, target-agnostic secrets) ======
# Copy this file to config/VARS.env (gitignored) and fill in real values:
#   cp config_template/VARS.env config/VARS.env
# Plain dotenv: KEY="value" per line; quote values containing $.
# Loaded on demand by scripts/renovate.sh. The in-cluster CronJob uses the
# matching values in config/srv0/values.yaml, rendered into its own Secret.

# GitHub token Renovate uses to open update PRs on the Infra repo.
# Fine-grained PAT: Contents -> Read and write, Pull requests -> Read and write
# (classic alternative: a token with the `repo` scope).
RENOVATE_GITHUB_TOKEN="change_me"

# Repository lists are not here: INFRA_REPO and APP_REPOS live in
# config/srv0/values.yaml (targets/srv0/config_template/values.yaml), the same
# values the scheduled CronJob renders into its Secret. scripts/repos.sh reads
# that file for manual runs.

# Read-only Docker Hub credentials for Renovate's registry lookups (avoids
# anonymous pull-rate limits). Image builds push to GHCR and need no Docker Hub
# credentials. Use a Docker Hub PAT, not the account password.
DOCKERHUB_USER="change_me"
DOCKERHUB_TOKEN="change_me"
