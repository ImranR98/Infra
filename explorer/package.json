{
  "name": "infra-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "map": "node scripts/build-map.mjs",
    "dev": "npm run map && vite --host 0.0.0.0",
    "build": "npm run map && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run map && tsc --noEmit && node scripts/check-map.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
