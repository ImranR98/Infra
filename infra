#!/bin/bash
# infra — short commands for the everyday ops. Thin wrapper over ansible-playbook:
# resolves the repo root, cd's there (the root ansible.cfg is auto-discovered
# from CWD) and execs the playbook. Extra args pass through unchanged (-e,
# --check, --dry-run, ...). Works from any directory and via a symlink in PATH.
#
# The target is ALWAYS explicit — never inferred from the hostname.
# Target-selecting ops are `infra <target> <op>`; machine-local ops (prereqs,
# renovate, and playbooks like preboot/wireguard/k3s-server/k3s-join) take no
# target because they only ever act on the machine they run on.

set -euo pipefail

_infra_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$_infra_root"

_die() {
    echo "infra: $*" >&2
    exit 1
}

# Become'd playbooks (docker tasks, package installs) need root; add -K unless
# sudo is already passwordless or the caller passed it.
_sudo_needed() {
    [ "$(id -u)" -eq 0 ] && return 1
    if sudo -n true 2>/dev/null; then
        return 1
    fi
    case " $* " in
        *" -K "* | *" --ask-become-pass "*) return 1 ;;
    esac
    return 0
}

_root_run() {
    local pb="$1"
    shift
    if _sudo_needed "$@"; then
        set -- -K "$@"
    fi
    exec ansible-playbook "$pb" "$@"
}

_run() {
    exec ansible-playbook "$@"
}

# Rewrites a bare --dry-run into the playbook's -e <var>="--dry-run" form
# (helm_apply/renovate read dry-run from extra vars). NUL-delimited output.
_dry_run_e() {
    local var="$1"
    shift
    local args=()
    for _a in "$@"; do
        if [ "$_a" = "--dry-run" ]; then
            args+=(-e "$var=--dry-run")
        else
            args+=("$_a")
        fi
    done
    if [ "${#args[@]}" -gt 0 ]; then
        printf '%s\0' "${args[@]}"
    fi
}

# The target comes from the infra argument; reject a conflicting -e target=...
# in the pass-through args.
_no_target_override() {
    local prev=""
    for _a in "$@"; do
        if [ "$prev" = "-e" ] || [ "$prev" = "--extra-vars" ]; then
            case "$_a" in
                target=*) _die "the target comes from the infra argument — drop your '-e target=...'" ;;
            esac
        fi
        case "$_a" in
            -e*|--extra-vars=*) case "$_a" in *target=*) _die "the target comes from the infra argument — drop your '-e target=...'" ;; esac ;;
        esac
        prev="$_a"
    done
}

_usage() {
    cat <<'EOF'
Usage: infra <target> <op> [args...]  — the target is explicit, never inferred
       infra <op> [args...]           — machine-local ops only (no target)

Target ops (target = targets/<t>; compose ops additionally must run on that
machine — the playbook's hostname assert enforces it):
  <target> validate                 yq + compose config + helm lint/template
  <target> compose-install          render compose templates, up -d
  <target> compose-restart <svc>    re-render, down+up one service
  <target> compose-backup           tar the compose state  ([-e backup_remote=user@host:path])
  <target> helm <base|apps>         apply that target's umbrella chart (preview: --dry-run)
  <target> pvc <backup|restore>     that target's PVC backup/restore script

Machine-local ops:
  prereqs                           install prerequisites
  renovate [--dry-run]              run Renovate
  <playbook-name>                   any machine-local playbook by basename —
                                    preboot, wireguard, k3s-server, k3s-join
EOF
    exit 1
}

# Machine-local named ops (checked before target interpretation).
case "${1:-}" in
    prereqs)
        shift
        _root_run ansible/playbooks/prereqs.yaml "$@"
        exit
        ;;
    renovate)
        shift
        mapfile -d '' _ren_args < <(_dry_run_e renovate_args "$@")
        _run ansible/playbooks/renovate.yaml "${_ren_args[@]}"
        exit
        ;;
esac

# Machine-local playbook by basename (hyphens normalized to underscores).
_arg="${1:-}"
_op="${_arg//-/_}"
case "$_arg" in
    validate | compose-install | compose-restart | compose-backup | helm | pvc)
        _die "target ops need an explicit target — usage: infra <target> $_arg ..." ;;
esac
if [ -n "$_op" ] && [ -f "ansible/playbooks/$_op.yaml" ]; then
    shift
    _run "ansible/playbooks/$_op.yaml" "$@"
    exit
fi

# Target mode: infra <target> <op>.
[ -n "$_arg" ] || _usage
[ -d "targets/$_arg" ] || {
    _die "unknown target or op '$_arg' — targets: $(find targets -mindepth 1 -maxdepth 1 -type d ! -name templates -printf '%f ' 2>/dev/null)"
}
_target="$_arg"
shift
[ $# -ge 1 ] || _die "usage: infra $_target <op> (target ops: validate, compose-install, compose-restart <svc>, compose-backup, helm <base|apps>, pvc <backup|restore>)"

_op="$1"
shift

case "$_op" in
    validate)
        _no_target_override "$@"
        _run ansible/playbooks/validate.yaml -e "target=$_target" "$@"
        ;;
    compose-install)
        _no_target_override "$@"
        _root_run ansible/playbooks/compose_install.yaml -e "target=$_target" "$@"
        ;;
    compose-restart)
        [ $# -ge 1 ] || _die "usage: infra $_target compose-restart <service>"
        _svc="$1"
        shift
        _no_target_override "$@"
        _root_run ansible/playbooks/compose_restart.yaml -e "target=$_target" -e compose_service="$_svc" "$@"
        ;;
    compose-backup)
        _no_target_override "$@"
        _root_run ansible/playbooks/compose_backup_state.yaml -e "target=$_target" "$@"
        ;;
    helm)
        case "${1:-}" in
            base | apps) ;;
            *) _die "usage: infra $_target helm <base|apps> [--dry-run]" ;;
        esac
        _helm_scope="$1"
        shift
        _helm_pb="targets/$_target/k3s/helm_apply.yaml"
        [ -f "$_helm_pb" ] || _die "target '$_target' has no $_helm_pb"
        mapfile -d '' _helm_args < <(_dry_run_e helm_args "$@")
        _run "$_helm_pb" -e helm_scope="$_helm_scope" "${_helm_args[@]}"
        ;;
    pvc)
        case "${1:-}" in
            backup | restore) ;;
            *) _die "usage: infra $_target pvc <backup|restore> [pvc.sh args...]" ;;
        esac
        [ -f "targets/$_target/pvc.sh" ] || _die "target '$_target' has no targets/$_target/pvc.sh"
        exec bash "targets/$_target/pvc.sh" "$@"
        ;;
    *)
        _die "unknown op '$_op' for target '$_target' — target ops: validate, compose-install, compose-restart <svc>, compose-backup, helm <base|apps>, pvc <backup|restore>"
        ;;
esac
