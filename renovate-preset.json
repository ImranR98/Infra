{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate policy for ImranR98 app repos. Extend with `github>ImranR98/Infra//renovate-preset` and keep only app-specific packageRules locally.",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    ":configMigration"
  ],
  "rangeStrategy": "replace",
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "labels": [
    "deps"
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on Monday"
    ]
  },
  "packageRules": [
    {
      "description": "Auto-merge non-major updates after the required test check",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Group non-major npm updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "npm deps (non-major)"
    },
    {
      "description": "Group non-major Python updates",
      "matchManagers": [
        "pip_requirements",
        "pip-compile",
        "pip_setup",
        "pep621"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "python deps (non-major)"
    },
    {
      "description": "Group non-major Docker updates",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "docker base images"
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "github actions (non-major)"
    },
    {
      "description": "Group non-major pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "pre-commit hooks (non-major)"
    },
    {
      "description": "Majors stay on the Dependency Dashboard until approved; never auto-merge them",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
