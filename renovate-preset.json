{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate policy for ImranR98 app repos. Extend with `github>ImranR98/Infra//renovate-preset` and keep only app-specific packageRules locally.",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    ":configMigration"
  ],
  "rangeStrategy": "replace",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "labels": [
    "deps"
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on Monday"
    ]
  },
  "packageRules": [
    {
      "description": "vite and @vitejs/plugin-react are peer-coupled: plugin-react 6 needs vite 7/8 and vite 8 needs plugin-react 6, so a major of either alone cannot resolve a lockfile. Group them so one branch carries both.",
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react"
      ],
      "groupName": "vite toolchain"
    },
    {
      "description": "Auto-merge non-major updates after the required test check",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Group non-major npm updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "npm deps (non-major)"
    },
    {
      "description": "Group non-major Python updates",
      "matchManagers": [
        "pip_requirements",
        "pip-compile",
        "pip_setup",
        "pep621"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "python deps (non-major)"
    },
    {
      "description": "Group non-major Docker updates",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "docker base images"
    },
    {
      "description": "Digest and pinDigest updates resolve to a digest, not a release, so Renovate has no releaseTimestamp for them and minimumReleaseAgeBehaviour=timestamp-required holds the PR pending forever (renovate/stability-days never clears, automerge never fires). Apply the 3-day gate only when a timestamp exists; this mirrors the timestamp-less registry rule in the Infra repo. Version bumps keep the strict timestamp-required gate.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "github actions (non-major)"
    },
    {
      "description": "Group non-major pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "pre-commit hooks (non-major)"
    },
    {
      "description": "Majors stay on the Dependency Dashboard until approved; never auto-merge them",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
