{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "helpers:pinGitHubActionDigests"
  ],
  "rangeStrategy": "replace",
  "prHourlyLimit": 20,
  "prConcurrentLimit": 20,
  "automerge": false,
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "labels": [
    "deps"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^targets\\/srv0\\/k3s-(base|apps)\\/.*\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Images inside the k3s charts (repository/tag pairs and single-line image refs). currentDigest is captured so digest-pinned images are recognized as pinned and refreshed; without it Renovate re-pins them and the branch update fails verification.",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-(base|apps)\\/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository:\\s*(?<depName>\\S+)\\s*\\n(?:[^\\n]*\\n){0,10}?\\s*tag:\\s*\"?(?<currentValue>[^\"\\s@#]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"?",
        "image:\\s*(?<depName>[^\\s@:\"']+):(?<currentValue>[^\\s@:\"'#]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "immich-machine-learning: GHCR publishes 200k+ tags (per-commit/PR/variant builds), so the docker datasource's fetch-all-pages enumeration intermittently fails and Renovate skips the update with no-result. Look the version up from the immich GitHub releases instead (tiny list, authenticated by the platform token). currentValue captures only the base version, so the default replacement preserves the backend suffix: v3.1.0-openvino -> v3.2.0-openvino, and likewise for -rocm/cuda/armnn/rknn.",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-apps\\/templates\\/immich.yaml/"
      ],
      "matchStrings": [
        "repository:\\s*(?<depName>ghcr\\.io/immich-app/immich-machine-learning)\\s*\\n\\s*tag:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)(?:-(?:openvino|rocm|cuda|armnn|rknn))?\"?"
      ],
      "packageNameTemplate": "immich-app/immich",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Frigate images, including the -rocm variant. currentValue captures the base version so the default replacement preserves the suffix.",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-apps\\/templates\\/frigate.yaml/"
      ],
      "matchStrings": [
        "image:\\s*ghcr\\.io/blakeblackshear/frigate:(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:-(?<variant>rocm))?"
      ],
      "depNameTemplate": "blakeblackshear/frigate",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "helm.cattle.io HelmChart CR chart versions (oci:// \u2014 via docker datasource; the helm datasource has no OCI support)",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-(base|apps)\\/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "chart:\\s*oci://(?<depName>\\S+)\\s*\\n(?:[^\\n]*\\n){0,5}?\\s*version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "helm.cattle.io HelmChart CR chart versions (classic chart:+repo: form)",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-(base|apps)\\/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "chart:\\s*(?<depName>\\S+)\\s*\\n(?:[^\\n]*\\n){0,5}?\\s*repo:\\s*(?<registryUrl>\\S+)\\s*\\n(?:[^\\n]*\\n){0,10}?\\s*version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "upgrade.cattle.io Plan CR k3s versions",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-(base|apps)\\/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "version:\\s*\"?v(?<currentValue>\\d+\\.\\d+\\.\\d+\\+k3s\\d+)\"?"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Traefik plugin version pins in additionalArguments (k3s HelmChartConfig + compose)",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-(base|apps)\\/.+\\.ya?ml$/",
        "/targets\\/.+\\/compose\\/compose\\.ya?ml$/"
      ],
      "matchStrings": [
        "--experimental\\.plugins\\.[^\\s.\"=]+\\.modulename=github\\.com/(?<owner>[^/]+)/(?<repo>[^\\s\"']+)[^\\n]*\\n\\s*-\\s*\"--experimental\\.plugins\\.[^\\s.\"=]+\\.version=v?(?<currentValue>[^\\s\"']+)"
      ],
      "depNameTemplate": "{{owner}}/{{repo}}",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Home Assistant Frigate integration pinned version (no runtime GitHub API polling)",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-apps\\/templates\\/homeassistant.yaml/"
      ],
      "matchStrings": [
        "repo=blakeblackshear/frigate-hass-integration\\n(?:[^\\n]*\\n){0,10}?\\s*latest=\"v(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "blakeblackshear/frigate-hass-integration",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Advanced Camera Card pinned version (no runtime GitHub API polling)",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-apps\\/templates\\/homeassistant.yaml/"
      ],
      "matchStrings": [
        "card=dermotduffy/advanced-camera-card\\n(?:[^\\n]*\\n){0,10}?\\s*card_latest=\"v(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "dermotduffy/advanced-camera-card",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "dotdc Grafana dashboard URLs in the k8s-monitoring values (all six dashboards share one version)",
      "managerFilePatterns": [
        "/targets\\/srv0\\/k3s-base\\/templates\\/monitoring\\.yaml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/dotdc/grafana-dashboards-kubernetes/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/"
      ],
      "depNameTemplate": "dotdc/grafana-dashboards-kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Pinned helm version in prereqs.sh",
      "managerFilePatterns": [
        "/scripts\\/prereqs\\.sh$/"
      ],
      "matchStrings": [
        "HELM_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Digest pins and refreshes are the manual rollout gate; bypass the release-age delay so new app images can be pinned immediately",
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "pin"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "One PR for all docker digest pins and refreshes (the noisy batch); version bumps stay separate",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "docker digests"
    },
    {
      "description": "nfs-server source deps: isolated PR; after merge the image workflow rebuilds and a later Infra Renovate pass opens the digest PR",
      "matchFileNames": [
        "targets/srv0/k3s-base/nfs-server-src/**"
      ],
      "groupName": "nfs source deps",
      "automerge": false
    },
    {
      "description": "Pin floating tags to digests",
      "matchDatasources": [
        "docker"
      ],
      "matchCurrentValue": "/^(latest|stable|release|alpine)$/",
      "pinDigests": true
    },
    {
      "description": "Guacamole webapp and guacd speak the same protocol; bump them together",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "guacamole/guacamole",
        "guacamole/guacd"
      ],
      "groupName": "guacamole"
    },
    {
      "description": "No major bumps for postgres, clickhouse/clickhouse-server, fedora, helm (their majors need manual migrations)",
      "matchPackageNames": [
        "postgres",
        "clickhouse/clickhouse-server",
        "fedora",
        "helm/helm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Compose-side syncthing on pc/bigpc is watchtower-owned",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "syncthing/syncthing"
      ],
      "enabled": false
    },
    {
      "description": "Authelia charts use the ghcr.io registry; track the actual image, not the registry-less Docker Hub name",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "authelia/authelia"
      ],
      "overridePackageName": "ghcr.io/authelia/authelia"
    },
    {
      "description": "Headlamp charts use the ghcr.io registry; track the actual image",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "headlamp-k8s/headlamp"
      ],
      "overridePackageName": "ghcr.io/headlamp-k8s/headlamp"
    },
    {
      "description": "Seerr charts use the ghcr.io registry; track the actual image",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "seerr-team/seerr"
      ],
      "overridePackageName": "ghcr.io/seerr-team/seerr"
    },
    {
      "description": "immich postgres: same-shape tags only (major-vectorchordX.Y.Z-pgvectorA.B.C), locked to the current postgres major via the compatibility group so pg-major jumps stay manual",
      "matchPackageNames": [
        "ghcr.io/immich-app/postgres"
      ],
      "versioning": "regex:^(?<compatibility>\\d+)-vectorchord(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-pgvector(?<pv_major>\\d+)\\.(?<pv_minor>\\d+)\\.(?<pv_patch>\\d+)$"
    },
    {
      "description": "immich-server: GHCR publishes ~30k tags, so the docker datasource's fetch-all-pages enumeration intermittently fails and Renovate skips the update with no-result. Look the version up from the immich GitHub releases instead (authenticated by the platform token).",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "immich-app/immich",
      "versioning": "semver"
    },
    {
      "description": "immich-machine-learning is handled by the dedicated github-releases custom manager; disable the generic docker dep so it neither re-hits the 200k-tag GHCR lookup nor drops the backend suffix. Excluding it in the generic regex is impossible because Renovate's regex engine (RE2) has no lookahead.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "enabled": false
    },
    {
      "description": "Frigate images are handled by the dedicated variant-aware manager; disable the generic docker dep so it does not propose an un-suffixed tag for the -rocm image.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/blakeblackshear/frigate"
      ],
      "enabled": false
    },
    {
      "description": "nfs-server image source: a Dockerfile base bump is inert until the image is rebuilt and the digest re-pinned",
      "matchFileNames": [
        "targets/srv0/k3s-base/nfs-server-src/Dockerfile"
      ],
      "prBodyNotes": [
        "After merging, the NFS server image workflow rebuilds and pushes a new digest; the next Renovate run (daily) pins it in the docker-digests PR. Deploy `srv0-base` after that PR merges. The Dockerfile bump alone does not change the running image."
      ]
    },
    {
      "description": "Final image digest pins are the manual rollout gate; label them for the renovate-pr-ops skill",
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "pin"
      ],
      "addLabels": [
        "infra-digest-pin"
      ],
      "matchDatasources": [
        "docker"
      ]
    }
  ]
}
