{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": ["master"],
  "gitAuthor": "Renovate Bot <renovate@atlas.local>",

  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["targets/.+/k3s/.*\\.yaml$"],
      "matchStrings": [
        "image:\\s*(?<depName>[^\\s@:\"']+):(?<currentValue>[^\\s@:\"'#]+)(?:@sha256:\\S+)?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "fileMatch": ["targets/.+/k3s/.*\\.yaml$"],
      "matchStrings": [
        "repository:\\s*(?<depName>\\S+)\\s*\\n(?:[^\\n]*\\n){0,10}?\\s*tag:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "fileMatch": ["targets/.+/k3s/.*\\.yaml$"],
      "matchStrings": [
        "chart:\\s*(?<depName>\\S+)\\s*\\n(?:[^\\n]*\\n){0,5}?\\s*repo:\\s*(?<registryUrl>\\S+)\\s*\\n(?:[^\\n]*\\n){0,10}?\\s*version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Pin floating tags (latest/stable/release) to digests",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "^(latest|stable|release)$",
      "pinDigests": true
    },
    {
      "description": "Prefer amd64 tags on x86_64, never switch archs",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "-amd64$",
      "allowedVersions": "/-amd64$/"
    },
    {
      "description": "Keep flavor suffixes (alpine, openssl, uclibc etc)",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "-(alpine|openssl|uclibc|slim|bookworm|bullseye|noble|jammy|oracle|pgvector|vectorchord|amazoncorretto)$",
      "allowedVersions": "/-(?:alpine|openssl|uclibc|slim|bookworm|bullseye|noble|jammy|oracle|pgvector|vectorchord|amazoncorretto)$/"
    }
  ]
}
