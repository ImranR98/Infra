{
  "listen": "0.0.0.0",
  "port": 8788,
  "stateDir": "/state",
  "enrollment": {
    "enabled": true,
    "windowSeconds": 0,
    "allowFrom": ["192.168.8.0/24"]
  },
  "jobs": {
    "wine-saves": {
      "type": "archive",
      "root": "/data/prefixes",
      "include": ["*/drive_c/users/steamuser"],
      "ignoreReadErrors": true,
      "format": "tar.gz",
      "maxBytes": 10737418240,
      "timeoutSeconds": 3600
    }
  }
}
