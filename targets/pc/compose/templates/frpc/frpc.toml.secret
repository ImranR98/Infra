serverAddr = "$PROXY_HOST"
serverPort = 7000
auth.additionalScopes = ["HeartBeats", "NewWorkConns"]
user = "client"
metadatas.token = "$FRPC_TOKEN"

[[proxies]]
name = "http"
type = "tcp"
localIP = "127.0.0.1"
localPort = 80
remotePort = 80
transport.useEncryption = true

[[proxies]]
name = "https"
type = "tcp"
localIP = "127.0.0.1"
localPort = 443
remotePort = 443
transport.useEncryption = true

[[proxies]]
name = "rtmp"
type = "tcp"
localIP = "127.0.0.1"
localPort = 1935
remotePort = 1935
transport.useEncryption = true
