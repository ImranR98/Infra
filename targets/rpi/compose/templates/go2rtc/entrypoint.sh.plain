#!/bin/sh
set -e

# Generate and persist the RTSP/API password on first start.
# (One-time notice only — the value itself stays out of the logs.)
if [ ! -s /config/password ]; then
    python3 -c 'import secrets; print(secrets.token_hex(16))' > /config/password
    echo "go2rtc: generated password in /config/password" >&2
fi
# Not world-readable; re-owned to the host user (uid of the bind-mount root,
# container runs as root) so it can be read on the host without docker exec.
chmod 600 /config/password
chown "$(stat -c %u /config 2>/dev/null || echo 0)" /config/password 2>/dev/null || true

# Substitute the placeholder with the persisted password (hex chars only, sed-safe).
sed -i "s/{{GO2RTC_PASSWORD}}/$(cat /config/password)/g" /config/go2rtc.yaml

# Watchdog: the webcam's v4l2/m2m pipeline occasionally wedges (ffmpeg freezes,
# no packets flow, clients time out). When consumers are connected but the source
# makes no packet progress, kill the ffmpeg process - go2rtc respawns it fresh.
(
    AUTH="admin:$(cat /config/password)"
    API="http://127.0.0.1:1984/api/streams?src=rpi"
    _packets() {
        curl -s -u "$AUTH" "$API" 2>/dev/null |
            python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    r=(d.get("producers",[{}])[0].get("receivers") or [{}])[0]
    print(r.get("packets",0))
except Exception:
    print(0)' 2>/dev/null || echo 0
    }
    _consumers() {
        curl -s -u "$AUTH" "$API" 2>/dev/null |
            python3 -c 'import json,sys
try:
    print(len(json.load(sys.stdin).get("consumers",[])))
except Exception:
    print(0)' 2>/dev/null || echo 0
    }
    while true; do
        sleep 15
        [ "$(_consumers)" -gt 0 ] || continue
        p1=$(_packets)
        sleep 12
        p2=$(_packets)
        if [ "$p2" -le "$p1" ]; then
            echo "watchdog: source stalled (packets $p1 -> $p2, consumers present), restarting ffmpeg" >&2
            pkill -f 'ffmpeg -hide_banner' 2>/dev/null || true
        fi
    done
) &

exec go2rtc -config /config/go2rtc.yaml
