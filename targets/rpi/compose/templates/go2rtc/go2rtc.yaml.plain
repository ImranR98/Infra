api:
    username: admin
    password: "{{GO2RTC_PASSWORD}}"
    local_auth: true

rtsp:
    listen: ":8554"
    username: admin
    password: "{{GO2RTC_PASSWORD}}"

ffmpeg:
    # Pipe ffmpeg output to go2rtc via stdout (MPEG-TS) instead of RTSP ingest:
    # the RTSP muxer writes its SDP before the encoder emits SPS/PPS, so clients
    # joining mid-stream never get them. TS carries them in-band from the start.
    output: "-f mpegts -"

streams:
    # cam: USB webcam RTSP stream
    # Single FFmpeg source: reads the webcam (container /dev/video2) directly as
    # MJPEG and transcodes to H.264 with software x264 (libx264). The Pi's hardware
    # encoder (h264_v4l2m2m via bcm2835-codec) was dropped: it wedges at the driver
    # level under client churn/load (ffmpeg freezes, no recovery without reboot).
    # Software encoding costs ~1 core of the Pi 400 but is fully reliable.
    # The entrypoint watchdog restarts the source if it ever stalls.
    cam:
        - ffmpeg:device?video=/dev/video2&input_format=mjpeg&video_size=1280x960&framerate=15#video=h264
