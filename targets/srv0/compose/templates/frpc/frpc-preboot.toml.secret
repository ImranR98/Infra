serverAddr = "$PROXY_IP"
serverPort = 7000
auth.additionalScopes = ["HeartBeats", "NewWorkConns"]
user = "client-preboot"
loginFailExit = true
metadatas.token = "$FRPC_PREBOOT_TOKEN"

[[proxies]]
name = "ssh-preboot"
type = "tcp"
localIP = "127.0.0.1"
localPort = 22
remotePort = 8887
transport.useEncryption = true
