serverAddr = "$PROXY_HOST"
serverPort = 7000
auth.additionalScopes = ["HeartBeats", "NewWorkConns"]

transport.tls.enable = true
transport.tls.serverName = "vps0"
transport.tls.certFile = "/etc/frp/client.crt"
transport.tls.keyFile = "/etc/frp/client.key"
transport.tls.trustedCaFile = "/etc/frp/ca.crt"

[[proxies]]
name = "ssh"
type = "tcp"
localIP = "127.0.0.1"
localPort = 22
remotePort = 8888

[[proxies]]
name = "http"
type = "tcp"
localIP = "127.0.0.1"
localPort = 80
remotePort = 8080
transport.useEncryption = true

[[proxies]]
name = "https"
type = "tcp"
localIP = "127.0.0.1"
localPort = 8443
remotePort = 8443
transport.useEncryption = true

[[proxies]]
name = "qbittorrent-peer-tcp"
type = "tcp"
localIP = "127.0.0.1"
localPort = 31581
remotePort = 56881

[[proxies]]
name = "qbittorrent-peer-udp"
type = "udp"
localIP = "127.0.0.1"
localPort = 31581
remotePort = 56881
