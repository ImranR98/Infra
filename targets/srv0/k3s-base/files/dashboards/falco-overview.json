      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"base\", app=\"falco\", container=\"falco\"} | json | __error__=\"\" | hostname=~\"$node\" | priority=~\"Critical|Error\" | rule=~\"$rule\" |= \"$search\" [$__range]))",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warning + Notice",
      "description": "Warning/notice events; mostly baseline noise until the rule tuning is done.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"base\", app=\"falco\", container=\"falco\"} | json | __error__=\"\" | hostname=~\"$node\" | priority=~\"Warning|Notice\" | rule=~\"$rule\" |= \"$search\" [$__range]))",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "editorMode": "code"
