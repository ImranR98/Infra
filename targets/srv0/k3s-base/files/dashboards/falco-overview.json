        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Top rules",
      "description": "Rules with the most matches in the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (rule) (count_over_time({namespace=\"base\", app=\"falco\", container=\"falco\"} | json | __error__=\"\" | hostname=~\"$node\" | priority=~\"$priority\" |= \"$search\" [$__range])))",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "editorMode": "code",
          "legendFormat": "{{rule}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "sort": "desc",
        "valueMode": "color"
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Recent events",
      "description": "Newest Falco events. Click a line for the full JSON fields.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"base\", app=\"falco\", container=\"falco\"} | json | __error__=\"\" | hostname=~\"$node\" | priority=~\"$priority\" | rule=~\"$rule\" |= \"$search\" | line_format \"[{{.priority}}] {{.rule}} | {{.output}}\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "editorMode": "code"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
