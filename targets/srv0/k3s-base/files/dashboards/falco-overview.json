      "targets": [
        {
          "refId": "A",
          "expr": "sum by (hostname) (rate({namespace=\"base\", app=\"falco\", container=\"falco\"} | json | __error__=\"\" | priority=~\"$priority\" | rule=~\"$rule\" |= \"$search\" [5m]))",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
