{{- if .Values.base.enabled }}
---
# Generates + installs the CDI specs (see prereqs.yaml) into /etc/cdi on every
# node. spc_t label lets the init container write the hostPath dir under
# SELinux; no privileged needed. Least-privilege: only the short-lived init
# container has /dev read + /etc/cdi write access — the long-running hold
# container mounts nothing, so a compromised installer pod cannot rewrite the
# spec (device-grant poisoning). Replug healing = rolling restart:
#   kubectl -n base rollout restart ds/cdi-specs
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: cdi-specs
  namespace: base
spec:
  selector:
    matchLabels:
      app: cdi-specs
  template:
    metadata:
      labels:
        app: cdi-specs
    spec:
      securityContext:
        seLinuxOptions:
          type: spc_t
      initContainers:
        - name: generate
          image: busybox:1.38
          command:
            - sh
            - -c
            - sh /spec/generate-spec.sh --once
          volumeMounts:
            - name: spec
              mountPath: /spec
            - name: cdi
              mountPath: /etc/cdi
            - name: dev
              mountPath: /dev
              readOnly: true
      containers:
        # Keep the pod alive (DaemonSet) but hold nothing: no mounts, no
        # write access. Regeneration happens only in the init container.
        - name: hold
          image: busybox:1.38
          command:
            - sleep
            - infinity
      volumes:
        - name: spec
          configMap:
            name: cdi-specs
        - name: cdi
          hostPath:
            path: /etc/cdi
            type: DirectoryOrCreate
        # Host /dev view (read-only): the generator scans it for the device
        # nodes to grant. stat() only — spc_t covers SELinux.
        - name: dev
          hostPath:
            path: /dev
            type: Directory
---
---
# CDI device plugin: registers the devices from /etc/cdi/infra.devices.json
# (see prereqs.yaml) with kubelet, so pods can request them as resources
# (infra.local/devices-conbee, infra.local/devices-dri). Runs on every node;
# nodes whose generated spec has no devices register nothing. spc_t (not
# privileged) covers the kubelet device-plugin socket dir + pod-resources
# socket under SELinux; the image runs as root. Internal base component, no
# ingress; the GRANTED pods stay non-privileged. Image is digest-pinned by
# Renovate (floating :main tag).
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: cdi-device-plugin
  namespace: base
spec:
  selector:
    matchLabels:
      app: cdi-device-plugin
  template:
    metadata:
      labels:
        app: cdi-device-plugin
    spec:
      containers:
        - name: plugin
          image: ghcr.io/olfillasodikno/generic-cdi-plugin:main
          imagePullPolicy: Always
          command:
            - /generic-cdi-plugin
            - /etc/cdi/infra.devices.json
          securityContext:
            seLinuxOptions:
              type: spc_t
            allowPrivilegeEscalation: false
          resources:
            limits:
              memory: 256Mi
            requests:
              memory: 64Mi
          volumeMounts:
            - name: device-plugins
              mountPath: /var/lib/kubelet/device-plugins
            - name: pod-resources
              mountPath: /var/lib/kubelet/pod-resources
            - name: cdi
              mountPath: /etc/cdi
              readOnly: true
      volumes:
        - name: device-plugins
          hostPath:
            path: /var/lib/kubelet/device-plugins
        - name: pod-resources
          hostPath:
            path: /var/lib/kubelet/pod-resources
        - name: cdi
          hostPath:
            path: /etc/cdi
            type: DirectoryOrCreate
---
---
# Per-node CDI spec generator. Each node scans its own /dev and writes
# /etc/cdi/infra.devices.json, so the grants follow the hardware, not a node
# label. Nodes with none of the devices get an empty spec and the plugin
# registers nothing.
#
# Resource names (per node, same everywhere):
#   infra.local/devices-conbee  -> first /dev/ttyACM*       (c 166:x)
#   infra.local/devices-dri     -> /dev/dri/renderD128      (c 226:128, VAAPI)
#   infra.local/devices-amd     -> /dev/kfd + all /dev/dri/* (ROCm, AMD nodes)
apiVersion: v1
kind: ConfigMap
metadata:
  name: cdi-specs
  namespace: base
data:
  generate-spec.sh: |
    #!/bin/sh
    # Generates /etc/cdi/infra.devices.json from this node's actual devices.
    # Invoked with `--once` by the cdi-specs init container. Re-run via a
    # DaemonSet rolling restart after hardware changes (replug etc.).
    set -e

    OUT=/etc/cdi/infra.devices.json
    first=1
    nodes=""

    add_node() {
      p="$1"
      [ -e "$p" ] || return 1
      t=$(stat -c %t "$p")
      t2=$(stat -c %T "$p")
      a=$(stat -c %a "$p")
      mjr=$((16#$t))
      mnr=$((16#$t2))
      fm=$((8#$a))
      [ -n "$nodes" ] && nodes="$nodes,"
      nodes="$nodes{\"path\":\"$p\",\"hostPath\":\"$p\",\"type\":\"c\",\"major\":$mjr,\"minor\":$mnr,\"fileMode\":$fm}"
    }

    emit_device() {
      n="$1"
      [ -n "$nodes" ] || return 1
      [ "$first" -eq 0 ] && printf ',\n'
      printf '    {"name":"%s","containerEdits":{"deviceNodes":[%s]}}' "$n" "$nodes"
      nodes=""
      first=0
    }

    generate() {
      first=1
      nodes=""
      {
        printf '{\n'
        printf '  "cdiVersion": "0.7.0",\n'
        printf '  "kind": "infra.local/devices",\n'
        printf '  "devices": [\n'
        for d in /dev/ttyACM0 /dev/ttyACM1 /dev/ttyACM2 /dev/ttyACM3; do
          if [ -e "$d" ]; then add_node "$d"; emit_device conbee; break; fi
        done
        if [ -e /dev/dri/renderD128 ]; then add_node /dev/dri/renderD128; emit_device dri; fi
        if [ -e /dev/kfd ]; then
          for d in /dev/kfd /dev/dri/card0 /dev/dri/card1 /dev/dri/renderD128 /dev/dri/renderD129; do
            add_node "$d" || true
          done
          emit_device amd
        fi
        printf '\n  ]\n'
        printf '}\n'
      } > "$OUT.tmp"
      mv "$OUT.tmp" "$OUT"
      chmod 644 "$OUT"
      echo "$(date +%T) wrote $OUT"
    }

    if [ "${1:-}" = "--once" ]; then
      generate
      exit 0
    fi

    while true; do
      generate || true
      sleep 300
    done
{{- end }}
