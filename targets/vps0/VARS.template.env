# ====== VARS template (dotenv) for vps0 ======
# Copy to secrets/VARS.vps0.env (gitignored), replace every placeholder with a
# real value, done — no encryption (see AGENTS.md). Consumed natively by
# docker compose via `--env-file` (no conversion step).
# Quoting: write single-line values unquoted; values containing $ or special
# characters go in single quotes (a $ in double quotes would be interpolated
# by compose — write '$argon2id$...' single-quoted or as $$argon2id$$...).
# Multi-line values are double-quoted with \n escapes.
# scripts/validate.sh vps0 rejects placeholders (change_me / changeme / abc /
# REPLACE_ME / <...>) and missing keys. Values never reach stdout.

# ====== Domain ======
# Base domain: services that stay on the original domain (public apps, FRP tunnel).
BASE_SERVICES_DOMAIN=staging.example.org
# Cloud tier domain: Authelia-protected services live here. Independent variable —
# set it explicitly (typically cloud.<your-base-domain>).
CLOUD_SERVICES_DOMAIN=cloud.staging.example.org
DOMAIN_OWNER_EMAIL=contact@example.org

# ====== Logtfy ======
NTFY_WRITE_ONLY_ACCOUNT_TOKEN=change_me # "tk_$(openssl rand -hex 16)"
NTFY_FALLBACK_TOPIC=change_me # openssl rand -hex 16

# ====== Geoblock (Traefik middleware) ======
# Committed in compose.yaml (configs: traefik_dynamic content) — the country
# allowlist is not secret.

# ====== Authelia ======
# users_database.yml is a REAL FILE at secrets/vps0/authelia/users_database.yml
# (mounted read-only). Generate the password hash with:
#   docker run -it authelia/authelia:latest authelia crypto hash generate argon2
AUTHELIA_DB_ENCRYPTION_KEY=change_me # openssl rand -hex 128
AUTHELIA_SESSION_SECRET=change_me # openssl rand -hex 128
AUTHELIA_JWT_SECRET=change_me # openssl rand -hex 128

# ====== Plausible Analytics ======
PLAUSIBLE_SECRET_KEY=change_me # openssl rand -base64 48
PLAUSIBLE_TOTP_VAULT_KEY=change_me # openssl rand -base64 32
PLAUSIBLE_DB_PASSWORD=change_me # openssl rand -hex 16

# ====== PixelNtfy ======
PIXELNTFY_TOPIC=change_me # openssl rand -hex 16

# ====== Moving Sale ======
MOVING_SALE_ADMIN_PASSWORD=change_me # openssl rand -hex 16
MOVING_SALE_PICKUP_TEXT=change_me # Pickup info text shown on the sale page
MOVING_SALE_PLAUSIBLE_SCRIPT_URL=change_me # Plausible analytics script tag URL (e.g. https://plausible.example.org/js/pa-xxxx.js)

# ====== CCT26 ======
CCT26_REDDIT_COOKIE=change_me # Reddit session cookie
CCT26_LLM_BASE_URL=change_me # LLM API base URL
CCT26_LLM_MODEL=change_me # LLM model name
CCT26_LLM_API_KEY=change_me # openssl rand -hex 32
CCT26_NTFY_URL=change_me # ntfy topic URL for notifications
CCT26_NTFY_AUTH=change_me # Authorization header value, e.g. "Bearer <ntfy token>"

# ====== strelaysrv Relay Server ======
STRELAYSRV_PROVIDED_BY=contact@example.org

# ====== Shlink URL Shortener ======
SHLINK_DB_PASSWORD=change_me # openssl rand -hex 32
SHLINK_API_KEY=change_me # openssl rand -hex 32
GEOLITE_LICENSE_KEY= # (optional, see Shlink docs)

# ====== Owncast ======
OWNCAST_ACCESS_TOKEN=change_me # openssl rand -hex 32

# ====== Crowdsec ======
CROWDSEC_BOUNCER_KEY=change_me # openssl rand -hex 32

# ====== FRP ======
# The mTLS certs are REAL FILES at secrets/vps0/frps/ (mounted read-only):
# ca.crt, server.crt, server.key. Generate the per-pair CA + certs with
# openssl (once per pair, on either machine; save the output directly there):
#   # CA
#   openssl req -x509 -newkey rsa:4096 -keyout ca.key -out ca.crt -days 3650 -nodes -subj "/CN=infra-mtls-ca"
#   # server (vps0)
#   openssl genrsa -out server.key 2048
#   openssl req -new -key server.key -out server.csr -subj "/CN=vps0"
#   openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt -days 1825

# ====== Machine facts (this host only) ======
# MY_UID / DOCKER_GID / USER are NOT in this file — they are machine facts,
# auto-generated into targets/vps0/compose/.env by scripts/prereqs.sh (run it
# once on vps0; re-run after uid/gid changes). The deploy command passes both
# files: --env-file secrets/VARS.vps0.env --env-file targets/vps0/compose/.env
TARGET=vps0
