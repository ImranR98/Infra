<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>1</background_merges_mutations_concurrency_ratio>
    <merge_tree>
        <max_bytes_to_merge_at_max_space_in_pool>2147483648</max_bytes_to_merge_at_max_space_in_pool>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    </merge_tree>
    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <engine>
            ENGINE = MergeTree
            PARTITION BY event_date
            ORDER BY (event_time)
            TTL event_date + interval 30 day
            SETTINGS ttl_only_drop_parts=1
        </engine>
    </query_log>
    <metric_log replace="1">
        <database>system</database>
        <table>metric_log</table>
        <engine>
            ENGINE = MergeTree
            PARTITION BY event_date
            ORDER BY (event_date, event_time)
            TTL event_date + INTERVAL 30 DAY DELETE
            SETTINGS ttl_only_drop_parts=1
        </engine>
    </metric_log>
    <asynchronous_metric_log replace="1">
        <database>system</database>
        <table>asynchronous_metric_log</table>
        <engine>
            ENGINE = MergeTree
            PARTITION BY event_date
            ORDER BY (metric, event_date, event_time)
            TTL event_date + INTERVAL 30 DAY DELETE
            SETTINGS ttl_only_drop_parts=1
        </engine>
    </asynchronous_metric_log>
    <processors_profile_log remove="remove" />
    <query_metric_log remove="remove" />
    <asynchronous_insert_log remove="remove" />
    <query_thread_log remove="remove" />
    <text_log remove="remove" />
    <trace_log remove="remove" />
    <session_log remove="remove" />
    <part_log remove="remove" />
</clickhouse>
