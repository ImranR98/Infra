jwt_secret: '$AUTHELIA_JWT_SECRET'

log:
  level: debug

totp:
  issuer: $CLOUD_SERVICES_DOMAIN

authentication_backend:
  file:
    path: /config/users_database.yml

access_control:
  default_policy: 'deny'
  rules:
    - domain: auth.$CLOUD_SERVICES_DOMAIN
      policy: bypass
    - domain: ytdl.$CLOUD_SERVICES_DOMAIN
      policy: one_factor
      subject:
      - 'group:family'
      - 'group:guests'
    - domain: ikom.$CLOUD_SERVICES_DOMAIN
      policy: one_factor
      subject:
      - 'group:family'
    - domain: '*.$CLOUD_SERVICES_DOMAIN'
      policy: one_factor
      subject:
      - 'group:admins'

session:
  secret: '$AUTHELIA_SESSION_SECRET'
  cookies:
    - domain: $CLOUD_SERVICES_DOMAIN
      authelia_url: https://auth.$CLOUD_SERVICES_DOMAIN

  redis:
    host: authelia-db
    port: 6379

regulation:
  max_retries: 3
  find_time: 120
  ban_time: 900

storage:
  encryption_key: '$AUTHELIA_DB_ENCRYPTION_KEY'
  local:
    path: /config/db.sqlite3

notifier:
  filesystem:
    filename: /config/notification.txt
