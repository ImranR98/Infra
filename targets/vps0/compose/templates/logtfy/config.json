{
    "ntfyConfig": {
        "configs": [
            {
                "id": "ntfy_home",
                "host": "https://ntfy.home.{{ BASE_SERVICES_DOMAIN }}",
                "authHeader": "Bearer {{ NTFY_WRITE_ONLY_ACCOUNT_TOKEN }}",
                "topicPrefix": "{{ TARGET }}_services_"
            },
            {
                "id": "ntfy_official",
                "host": "https://ntfy.sh",
                "authHeader": null,
                "topicPrefix": "{{ NTFY_FALLBACK_TOPIC }}"
            }
        ],
        "defaultConfig": "ntfy_home",
        "fallbackConfig": "ntfy_official"
    },
    "modulesEnabledByDefault": false,
    "moduleCustomization": [
        {
            "module": "ssh_logins",
            "ntfyTopic": "logtfy",
            "enabled": true,
            "loggerArg": "ssh"
        },
        {
            "module": "authelia_logins",
            "ntfyTopic": "logtfy",
            "enabled": true
        },
        {
            "module": "generic_logs",
            "moduleInstances": [
                {
                    "name": "frps_ssh_preboot",
                    "enabled": true,
                    "loggerArg": "frps stderr2stdout",
                    "parserArg": "{\"regex\":\"\\\\[ssh-preboot\\\\] get a user connection\",\"title\":\"FRP: SSH preboot connection\",\"message\":\"New connection to the ssh-preboot tunnel:\"}",
                    "ntfyTopic": "logtfy"
                }
            ]
        }
    ]
}
