{
    "ntfyConfig": {
        "configs": [
            {
                "id": "ntfy_home",
                "host": "https://ntfy.home.$SERVICES_DOMAIN",
                "authHeader": "Bearer $NTFY_WRITE_ONLY_ACCOUNT_TOKEN",
                "topicPrefix": "${TARGET}_services_"
            },
            {
                "id": "ntfy_official",
                "host": "https://ntfy.sh",
                "authHeader": null,
                "topicPrefix": "${NTFY_FALLBACK_TOPIC}"
            }
        ],
        "defaultConfig": "ntfy_home",
        "fallbackConfig": "ntfy_official"
    },
    "modulesEnabledByDefault": false,
    "allowModuleFailCount": 3,
    "moduleCustomization": [
        {
            "module": "ssh_logins",
            "ntfyTopic": "logtfy",
            "enabled": true,
            "loggerArg": "ssh"
        },
        {
            "module": "authelia_logins",
            "ntfyTopic": "logtfy",
            "enabled": true
        },
        {
            "module": "watchtower_updates",
            "ntfyTopic": "logtfy",
            "enabled": true
        }
    ]
}
