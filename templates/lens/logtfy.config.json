{
    "ntfyConfig": {
        "configs": [
            {
                "id": "ntfy_home",
                "host": "https://ntfy.$SERVICES_DOMAIN",
                "authHeader": "Bearer $NTFY_SERVICE_USER_TOKEN",
                "topicPrefix": "${TARGET}_services_"
            },
            {
                "id": "ntfy_official",
                "host": "https://ntfy.sh",
                "authHeader": null,
                "topicPrefix": "${NTFY_FALLBACK_TOPIC}"
            }
        ],
        "defaultConfig": "ntfy_home",
        "fallbackConfig": "ntfy_official"
    },
    "modulesEnabledByDefault": false,
    "catchModuleCrashes": false,
    "allowModuleFailCount": 3,
    "moduleCustomization": [
      {
        "module": "ssh_logins",
        "ntfyTopic": "logtfy",
        "enabled": true,
        "loggerArg": "ssh"
      },
      {
        "module": "port_checker",
        "ntfyTopic": "logtfy",
        "enabled": true,
        "loggerArg": "localhost 8888"
      }
    ]
}
